---
import { services } from '../data/services';
---

<section id="booking" class="bg-slate-900 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-400">Онлайн запись</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Выберите услугу и удобное время
      </h2>
      <p class="mt-4 text-slate-400">
        В демо-версии виджет записи ещё не подключён. На продакшене здесь будет Cal.com или YClients.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-lg">
      <form id="booking-form" class="space-y-4 rounded-2xl border border-white/10 bg-slate-850 p-6 sm:p-8">
        <div>
          <label for="booking-service" class="mb-1.5 block text-sm font-medium text-slate-300">
            Услуга
          </label>
          <select
            id="booking-service"
            name="service"
            class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-white outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
          >
            {
              services.map((s) => (
                <option value={s.id}>{s.name} — {s.price}</option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="booking-date" class="mb-1.5 block text-sm font-medium text-slate-300">
            Желаемая дата
          </label>
          <input
            type="date"
            id="booking-date"
            name="date"
            required
            class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-white outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
          />
        </div>
        <div>
          <label for="booking-name" class="mb-1.5 block text-sm font-medium text-slate-300">
            Ваше имя
          </label>
          <input
            type="text"
            id="booking-name"
            name="name"
            required
            placeholder="Иван"
            class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-600 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
          />
        </div>
        <div>
          <label for="booking-phone" class="mb-1.5 block text-sm font-medium text-slate-300">
            Телефон
          </label>
          <input
            type="tel"
            id="booking-phone"
            name="phone"
            required
            placeholder="+7 (999) 000-00-00"
            class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-600 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
          />
        </div>
        <button
          type="submit"
          class="w-full rounded-xl bg-brand-500 py-3.5 text-base font-semibold text-white transition-colors hover:bg-brand-600"
        >
          Отправить заявку
        </button>
        <p id="booking-success" class="hidden rounded-lg bg-green-500/10 px-4 py-3 text-center text-sm text-green-400" role="status" aria-live="polite">
          Заявка принята! Мы перезвоним для подтверждения записи.
        </p>
      </form>
      <p class="mt-4 text-center text-xs text-slate-500">
        Демо: форма не отправляет данные на сервер
      </p>
    </div>
  </div>
</section>

<script>
  const params = new URLSearchParams(window.location.search);
  const serviceParam = params.get('service');
  const select = document.getElementById('booking-service') as HTMLSelectElement | null;
  if (serviceParam && select) {
    const option = select.querySelector(`option[value="${serviceParam}"]`);
    if (option) select.value = serviceParam;
  }

  const form = document.getElementById('booking-form');
  const success = document.getElementById('booking-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    success?.classList.remove('hidden');
    form.querySelector('button[type="submit"]')?.setAttribute('disabled', 'true');
    setTimeout(() => {
      form.reset();
      success?.classList.add('hidden');
      form.querySelector('button[type="submit"]')?.removeAttribute('disabled');
    }, 4000);
  });

  const dateInput = document.getElementById('booking-date') as HTMLInputElement | null;
  if (dateInput) {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    dateInput.min = tomorrow.toISOString().split('T')[0];
  }
</script>
