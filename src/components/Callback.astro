---
import { site } from '../data/site';
---

<section id="callback" class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-slate-900 to-slate-850">
      <div class="grid lg:grid-cols-2">
        <div class="p-8 sm:p-12">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-400">Обратный звонок</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-white">
            Перезвоним за 15 минут
          </h2>
          <p class="mt-4 text-slate-400">
            Оставьте номер — мастер свяжется с вами, ответит на вопросы и поможет записаться.
            На продакшене заявки будут приходить в Telegram.
          </p>
          <a
            href={site.phoneHref}
            class="mt-8 inline-flex items-center gap-2 text-lg font-semibold text-white hover:text-brand-400 transition-colors"
          >
            <svg class="h-6 w-6 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            или позвоните: {site.phone}
          </a>
        </div>

        <form id="callback-form" class="border-t border-white/10 bg-slate-950/50 p-8 sm:p-12 lg:border-l lg:border-t-0">
          <div class="space-y-4">
            <div>
              <label for="cb-name" class="mb-1.5 block text-sm font-medium text-slate-300">Имя</label>
              <input
                type="text"
                id="cb-name"
                name="name"
                required
                placeholder="Как к вам обращаться?"
                class="w-full rounded-lg border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-600 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
              />
            </div>
            <div>
              <label for="cb-phone" class="mb-1.5 block text-sm font-medium text-slate-300">Телефон</label>
              <input
                type="tel"
                id="cb-phone"
                name="phone"
                required
                placeholder="+7 (999) 000-00-00"
                class="w-full rounded-lg border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-600 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
              />
            </div>
            <div>
              <label for="cb-time" class="mb-1.5 block text-sm font-medium text-slate-300">
                Удобное время (необязательно)
              </label>
              <input
                type="text"
                id="cb-time"
                name="time"
                placeholder="Например: после 18:00"
                class="w-full rounded-lg border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-600 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
              />
            </div>
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <label class="flex items-start gap-2 text-sm text-slate-400">
              <input type="checkbox" required class="mt-1 rounded border-white/20 bg-slate-900 text-brand-500 focus:ring-brand-500" />
              <span>Согласен на обработку персональных данных</span>
            </label>
            <button
              type="submit"
              class="w-full rounded-xl bg-brand-500 py-3.5 font-semibold text-white transition-colors hover:bg-brand-600"
            >
              Жду звонка
            </button>
            <p id="callback-success" class="hidden rounded-lg bg-green-500/10 px-4 py-3 text-center text-sm text-green-400" role="status" aria-live="polite">
              Спасибо! Перезвоним в ближайшее время.
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('callback-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
    if (honeypot?.value) return;

    const success = document.getElementById('callback-success');
    success?.classList.remove('hidden');
    form.querySelector('button[type="submit"]')?.setAttribute('disabled', 'true');
    setTimeout(() => {
      form.reset();
      success?.classList.add('hidden');
      form.querySelector('button[type="submit"]')?.removeAttribute('disabled');
    }, 4000);
  });
</script>
