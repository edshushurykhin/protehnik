---
import { site, sectionBgs } from '../data/site';
import SectionBg from './SectionBg.astro';

const mapSrc = `https://yandex.ru/map-widget/v1/?ll=${site.mapLon}%2C${site.mapLat}&z=17&l=map&pt=${site.mapLon},${site.mapLat},pm2rdm`;
---

<section id="contacts" class="relative overflow-hidden py-20 sm:py-24">
  <SectionBg src={sectionBgs.contacts} tone="heavy" />

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-400">Контакты</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Как нас найти
      </h2>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-stretch">
      <div class="space-y-6">
        <div class="flex gap-4 rounded-2xl border border-white/10 bg-slate-950/70 p-6 backdrop-blur-sm">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-brand-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-white">Адрес</h3>
            <p class="mt-1 text-slate-300">{site.address}</p>
          </div>
        </div>

        <div class="flex gap-4 rounded-2xl border border-white/10 bg-slate-950/70 p-6 backdrop-blur-sm">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-brand-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-white">Телефон</h3>
            <a href={site.phoneHref} class="mt-1 block text-brand-400 hover:text-brand-500 transition-colors">
              {site.phone}
            </a>
          </div>
        </div>

        <div class="flex gap-4 rounded-2xl border border-white/10 bg-slate-950/70 p-6 backdrop-blur-sm">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-brand-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-white">Часы работы</h3>
            <p class="mt-1 text-slate-300">{site.hours}</p>
            <p class="text-slate-300">{site.hoursWeekend}</p>
          </div>
        </div>

        <div class="flex gap-4 rounded-2xl border border-white/10 bg-slate-950/70 p-6 backdrop-blur-sm">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-brand-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-white">Почта</h3>
            <a href={`mailto:${site.email}`} class="mt-1 block text-brand-400 hover:text-brand-500 transition-colors">
              {site.email}
            </a>
          </div>
        </div>
      </div>

      <div class="flex min-h-[480px] flex-col overflow-hidden rounded-2xl border border-white/10 bg-slate-950/70 backdrop-blur-sm lg:min-h-full">
        <iframe
          title="Карта — ПРОтехник, ул. 2-я Брянская, 55 стр. 2"
          src={mapSrc}
          class="min-h-[480px] w-full flex-1"
          loading="lazy"
          allowfullscreen
        ></iframe>
        <p class="shrink-0 px-4 py-3 text-center text-xs text-slate-400">
          {site.streetAddress}
        </p>
      </div>
    </div>
  </div>
</section>
