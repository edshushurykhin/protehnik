---
import { site, nav } from '../data/site';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur-lg"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="#home" class="group flex items-center gap-2">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-500 text-sm font-extrabold text-white"
      >
        ПР
      </span>
      <div class="leading-tight">
        <span class="block text-base font-bold tracking-tight text-white group-hover:text-brand-400 transition-colors">
          {site.name}
        </span>
        <span class="hidden text-xs text-slate-400 sm:block">{site.slogan}</span>
      </div>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Основная навигация">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-slate-300 transition-colors hover:text-brand-400"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={site.phoneHref}
        class="hidden text-sm font-semibold text-white transition-colors hover:text-brand-400 md:block"
      >
        {site.phone}
      </a>
      <a
        href="#booking"
        class="rounded-lg bg-brand-500 px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-600 sm:px-4"
      >
        Записаться
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 text-slate-300 lg:hidden"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-slate-950 px-4 py-4 lg:hidden"
    aria-label="Мобильная навигация"
  >
    <div class="flex flex-col gap-1">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link rounded-lg px-3 py-2.5 text-sm font-medium text-slate-300 hover:bg-white/5 hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.phoneHref}
        class="mt-2 rounded-lg px-3 py-2.5 text-sm font-semibold text-brand-400"
      >
        {site.phone}
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
