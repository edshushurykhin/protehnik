---
import { site } from '../data/site';

const heroImage =
  'https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?w=1600&q=80&auto=format&fit=crop';
---

<section id="home" class="relative overflow-hidden pt-20">
  <div class="absolute inset-0">
    <img
      src={heroImage}
      alt="Мастер проводит диагностику автомобиля"
      class="h-full w-full object-cover"
      width="1600"
      height="900"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32 lg:py-40">
    <div class="max-w-2xl">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-1.5 text-sm font-medium text-brand-400">
        <span class="h-2 w-2 rounded-full bg-brand-500"></span>
        {site.slogan}
      </p>
      <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        Надёжный ремонт<br />
        <span class="text-brand-400">вашего автомобиля</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
        Диагностика, ТО и ремонт подвески в Красноярске. Честные цены, гарантия на работы
        и запчасти. Запишитесь онлайн или закажите обратный звонок.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#booking"
          class="inline-flex items-center justify-center rounded-xl bg-brand-500 px-6 py-3.5 text-base font-semibold text-white transition-colors hover:bg-brand-600"
        >
          Записаться на сервис
        </a>
        <a
          href={site.phoneHref}
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 text-base font-semibold text-white backdrop-blur transition-colors hover:bg-white/10"
        >
          <svg class="h-5 w-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          {site.phone}
        </a>
      </div>

      <dl class="mt-14 grid grid-cols-3 gap-4 border-t border-white/10 pt-8 sm:gap-8">
        <div>
          <dt class="text-2xl font-bold text-white sm:text-3xl">10+</dt>
          <dd class="mt-1 text-xs text-slate-400 sm:text-sm">лет опыта</dd>
        </div>
        <div>
          <dt class="text-2xl font-bold text-white sm:text-3xl">2 000+</dt>
          <dd class="mt-1 text-xs text-slate-400 sm:text-sm">довольных клиентов</dd>
        </div>
        <div>
          <dt class="text-2xl font-bold text-white sm:text-3xl">12 мес</dt>
          <dd class="mt-1 text-xs text-slate-400 sm:text-sm">гарантия на работы</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
