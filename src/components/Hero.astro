---
import { site, sectionBgs } from '../data/site';
import MessengerButtons from './MessengerButtons.astro';
---

<section id="home" class="relative overflow-hidden pt-20">
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src={sectionBgs.hero}
      alt=""
      class="h-full w-full object-cover object-center"
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-950/35"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-slate-950/20"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32 lg:py-40">
    <div class="max-w-2xl">
      <div class="mb-6 flex flex-wrap items-center gap-4 sm:gap-5">
        <img
          src="/logo.png"
          alt=""
          width="280"
          height="75"
          class="h-14 w-auto max-w-[min(100%,17.5rem)] shrink-0 rounded-xl object-contain ring-1 ring-brand-500/70 sm:h-[4.75rem]"
          fetchpriority="high"
          decoding="async"
        />
        <div>
          <p class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">{site.name}</p>
          <p class="mt-0.5 text-sm font-medium text-brand-400 sm:text-base">{site.slogan}</p>
        </div>
      </div>
      <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        Надёжный ремонт<br />
        <span class="text-brand-400">вашего автомобиля</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
        Диагностика подвески и систем, ТО, шиномонтаж и ремонт в Красноярске.
        Честные цены, гарантия на работы. Позвоните или закажите обратный звонок.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href={site.phoneHref}
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-500 px-6 py-3.5 text-base font-semibold text-white transition-colors hover:bg-brand-600"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          {site.phone}
        </a>
        <a
          href="#callback"
          class="inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 text-base font-semibold text-white backdrop-blur transition-colors hover:bg-white/10"
        >
          Обратный звонок
        </a>
      </div>
      <div class="mt-4">
        <MessengerButtons size="md" />
      </div>

      <dl class="mt-14 grid grid-cols-1 gap-5 border-t border-white/10 pt-8 sm:grid-cols-3 sm:gap-8">
        <div>
          <dt class="text-base font-bold text-white sm:text-lg">Опытные мастера</dt>
          <dd class="mt-1 text-sm text-slate-400">Знаем особенности разных марок</dd>
        </div>
        <div>
          <dt class="text-base font-bold text-white sm:text-lg">Положительные отзывы</dt>
          <dd class="mt-1 text-sm text-slate-400">Клиенты остаются довольны</dd>
        </div>
        <div>
          <dt class="text-base font-bold text-brand-400 sm:text-lg">Диагностика 0 ₽</dt>
          <dd class="mt-1 text-sm text-slate-400">Проверим без доплат</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
