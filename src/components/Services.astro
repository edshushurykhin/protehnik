---
import { services } from '../data/services';
import { site, sectionBgs } from '../data/site';
import SectionBg from './SectionBg.astro';
---

<section id="services" class="relative overflow-hidden py-20 sm:py-24">
  <SectionBg src={sectionBgs.services} tone="heavy" />

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-400">Услуги и цены</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Всё для вашего авто в одном месте
      </h2>
      <p class="mt-4 text-slate-300">
        Актуальные цены на основные работы. Точная стоимость зависит от марки и модели автомобиля.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        services.map((service) => {
          const isFree = service.price === 'БЕСПЛАТНО';
          return (
            <article
              class:list={[
                'group rounded-2xl border p-6 backdrop-blur-sm transition-colors',
                isFree
                  ? 'border-brand-500/60 bg-brand-500/15 ring-1 ring-brand-500/40 hover:border-brand-500'
                  : 'border-white/10 bg-slate-950/70 hover:border-brand-500/30',
              ]}
            >
              <div class="flex items-start justify-between gap-4">
                <span class="text-3xl" aria-hidden="true">
                  {service.icon}
                </span>
                <span
                  class:list={[
                    'shrink-0 rounded-lg px-3 py-1 text-sm font-bold uppercase tracking-wide',
                    isFree
                      ? 'bg-brand-500 text-white shadow-lg shadow-brand-500/30'
                      : 'bg-brand-500/15 font-semibold normal-case tracking-normal text-brand-400',
                  ]}
                >
                  {service.price}
                </span>
              </div>
              <h3 class="mt-4 text-xl font-semibold text-white">{service.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-300">{service.description}</p>
              <a
                href={site.phoneHref}
                class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-400 transition-colors group-hover:text-brand-500"
              >
                Позвонить
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </article>
          );
        })
      }
    </div>

    <p class="mt-8 text-center text-sm text-slate-400">
      Цены указаны за работу без учёта запчастей. Актуально на {new Date().toLocaleDateString('ru-RU')}.
    </p>
  </div>
</section>
